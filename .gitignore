# .gitignore

# Temporary files
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
.project
.pydevproject

# Analysis temporary files
/tmp/
*.log

# Large binary analysis outputs (keep the firmware and extracted partitions, but not temp files)
*.ghidra/
*.i64
*.idb
*.nam
*.til
*_decompiled/

# Don't ignore actual firmware files or analysis results
!firmware/*.bin
!analysis/*.txt
!analysis/*.md
!analysis/partitions/*.bin

# OS specific
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
